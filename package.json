{
  "name": "impacto-batalha-2d",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Frederico Andrade",
  "type": "module",
  "imports": {
    "#dynamics-host": {
      "node": "./scripts/native-dynamics-host.ts",
      "default": "./src/wasm-dynamics-host.ts"
    }
  },
  "scripts": {
    "predev": "node scripts/build-dynamics.ts --prepare --quick",
    "dev": "vite --port 8131 --strictPort",
    "start": "npm run dev",
    "prebuild": "npm run check && node scripts/build-dynamics.ts --prepare",
    "build": "vite build",
    "build:wasm": "node scripts/build-dynamics.ts",
    "build:native": "node scripts/build-dynamics.ts --native",
    "export:public": "node scripts/export-public.ts",
    "licenses": "node scripts/third-party-notices.ts",
    "preview": "vite preview --port 8131 --strictPort",
    "stress": "node scripts/stress-field.ts",
    "stress:measure": "node scripts/stress-measure.ts",
    "benchmark:mobile:prepare": "node scripts/mobile-benchmark-prepare.ts",
    "benchmark:mobile": "node scripts/mobile-benchmark.ts",
    "pretest:rust": "node scripts/export-construction-catalogue.ts && npm run check:native-contract",
    "test:rust": "cargo test --manifest-path native/dynamics/Cargo.toml --locked --features native-parallel",
    "pretest": "npm run check",
    "test": "node scripts/run-tests.ts",
    "typecheck": "node scripts/check-typescript.ts && tsc -p tsconfig.json && tsc -p src/tsconfig.json",
    "check": "npm run typecheck && npm run check:translations",
    "check:translations": "node scripts/check-translations.ts",
    "generate:native-contract": "cargo run --quiet --locked --manifest-path native/dynamics/Cargo.toml --features typegen --bin export-typescript",
    "check:native-contract": "npm run generate:native-contract -- -- --check",
    "size": "node scripts/codebase-size.ts",
    "check:structure": "node --test --test-reporter=tap tests/module-dependencies.test.js",
    "review": "node scripts/review.ts",
    "review:native-host": "node scripts/review-native-host.ts",
    "benchmark": "node scripts/review.ts benchmark",
    "review:arsenal": "node scripts/review.ts arsenal",
    "review:industry": "node scripts/review-industry.ts",
    "review:industry:abuse": "node scripts/review-industry-abuse.ts",
    "review:industry:missions": "node scripts/review-industry-missions.ts",
    "review:industry:openings": "node scripts/review-industry-openings.ts",
    "review:resources": "node scripts/review-resource-access.ts",
    "review:mining": "node scripts/review-mining-logistics.ts",
    "review:commanders": "node scripts/review-commanders.ts",
    "review:commander-combat": "node scripts/review-commander-combat.ts",
    "replay:viewer": "node scripts/replay-viewer.ts",
    "player": "node scripts/player.ts",
    "review:industry:capture": "node scripts/review-industry-capture.ts",
    "review:explosives": "node scripts/review.ts explosives",
    "review:durability": "node scripts/review.ts durability",
    "review:stability": "node scripts/review.ts stability",
    "review:lab": "node scripts/review.ts lab",
    "review:vehicle-blasts": "node scripts/review.ts vehicle-blasts",
    "review:artillery-vehicle": "node scripts/review.ts artillery",
    "review:terrain": "node scripts/review.ts terrain",
    "review:environment": "node scripts/review.ts environment",
    "review:performance": "node scripts/review.ts performance",
    "review:explosion-performance": "node scripts/review.ts explosion-performance",
    "review:secondary": "node scripts/review.ts secondary",
    "review:blast-launch": "node scripts/review.ts blast-launch",
    "review:mortar-light": "node scripts/review.ts mortar-roof",
    "review:light-wheel": "node scripts/review.ts light-wheel"
  },
  "dependencies": {
    "earcut": "3.2.4",
    "pixi.js": "8.22.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
