# Para o perfil opcional do túnel, use o endereço HTTPS próprio e o token da Cloudflare.
TUNNEL_TOKEN=
# IMPACTO_ADDRESS=https://jogo.example/
# IMPACTO_SOURCE_URL=https://github.com/FredericoAndrade1000/impacto
# IMPACTO_AI_MIN_PLAYERS=0
# IMPACTO_CLIENT_TELEMETRY=0
# IMPACTO_DISCOVER_LAN=0

# Compose fixa os IPs do tunnel e do jogo. Mude os quatro juntos se a sub-rede conflitar.
# IMPACTO_BRIDGE_SUBNET=172.29.110.0/29
# IMPACTO_BRIDGE_GATEWAY=172.29.110.1
# IMPACTO_TUNNEL_IP=172.29.110.2
# IMPACTO_GAME_IP=172.29.110.3

# Host Node fora do Compose: exporte estas variáveis antes de iniciar o servidor.
# Lista de IPs exatos, vazia por padrão, inclusive para proxies em loopback.
# IMPACTO_TRUSTED_PROXIES=127.0.0.1,::1
# IMPACTO_PROXY_IP_HEADER=x-forwarded-for
# Use cf-connecting-ip com cloudflared. O proxy deve definir o cabeçalho escolhido
# e X-Forwarded-Proto. Com X-Forwarded-For, o proxy deve acrescentar o IP do peer.
# Para um acesso local HTTP através de outro endereço, indique somente o peer local.
# IMPACTO_LOCAL_HTTP_PEERS=

# Lista de servidores. URL sem chave habilita apenas a consulta no menu.
# Para anunciar, cadastre o endereço WSS na lista e configure a chave recebida.
# IMPACTO_DIRECTORY_URL=https://lista.example/
# IMPACTO_DIRECTORY_KEY=
# IMPACTO_DIRECTORY_ADDRESS=wss://jogo.example/world
# IMPACTO_DIRECTORY_NAME=Impacto
# IMPACTO_DIRECTORY_DESCRIPTION=Campo persistente
# IMPACTO_DIRECTORY_REGION=Brasil
# IMPACTO_DIRECTORY_LANGUAGE=pt-BR
# IMPACTO_DIRECTORY_FIELD=Campo principal
# IMPACTO_OFFICIAL_SERVER=wss://jogo-oficial.example/world
# Origens HTTPS exatas de páginas de outros servidores que podem acessar este campo.
# IMPACTO_CLIENT_ORIGINS=https://jogo-oficial.example

# Serviço da lista (compose.directory.yaml).
# IMPACTO_DIRECTORY_ORIGINS=https://jogo-oficial.example
# IMPACTO_DIRECTORY_TRUSTED_PROXIES=
# IMPACTO_DIRECTORY_PROXY_IP_HEADER=x-forwarded-for
# IMPACTO_DIRECTORY_BIND_PORT=8195
